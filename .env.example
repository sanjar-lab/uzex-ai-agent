# Anthropic Claude (main model)
ANTHROPIC_API_KEYS=
CLAUDE_MODEL=claude-sonnet-5-5

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Google AI Studio keys (aistudio.google.com/apikey), comma-separated; rotated round-robin
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.5-flash-lite
GEMINI_REASONING=low

# Groq fallback (console.groq.com/keys)
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING=medium

# Optional extra fallback
OPENROUTER_API_KEYS=

LLM_ORDER=claude,gemini,groq,openrouter

# On a server: public https URL of this service (Render sets RENDER_EXTERNAL_URL automatically).
# Empty = Telegram long-polling (local run).
PUBLIC_URL=
